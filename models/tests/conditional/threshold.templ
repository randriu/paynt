// Storm 2.0 never finishes deciding P>=-0.1 for the most of this property over the designs (see paynt.utils.conditional.model_check), which every design
// that reaches the condition satisfies. Found by tests/soundness/test_random_sketches.py.
dtmc

hole int H0 in {0..1};
hole int H1 in {0..1};

module m
    s : [0..5] init 0;
    [] s=0 & H0=0 -> 2/3 : (s'=2) + 1/3 : (s'=3);
    [] s=0 & H0=1 -> 3/7 : (s'=2) + 2/7 : (s'=3) + 2/7 : (s'=4);
    [] s=1 -> 4/10 : (s'=2) + 3/10 : (s'=0) + 3/10 : (s'=3);
    [] s=2 & H1=0 -> 4/6 : (s'=2) + 2/6 : (s'=0);
    [] s=2 & H1=1 -> 2/8 : (s'=4) + 2/8 : (s'=5) + 4/8 : (s'=1);
    [] s=3 & H0=0 -> 3/6 : (s'=0) + 3/6 : (s'=2);
    [] s=3 & H0=1 -> 1/1 : (s'=3);
    [] s=4 -> 1/5 : (s'=2) + 4/5 : (s'=4);
    [] s=5 -> true;
endmodule

label "goal" = s=5;
label "condition" = s=2;
