// h=0 never reaches the condition: its value is undefined, and it satisfies no property. h=1 reaches the goal after the condition with probability 1/4,
// h=2 with 3/4. Some paths reach the goal first and then the condition, which counts as well (h=2).
dtmc

hole int h in {0,1,2};

module m
    s : [0..4] init 0;

    [] s=0 & h=0 -> (s'=4);
    [] s=0 & h=1 -> (s'=1);
    [] s=0 & h=2 -> 1/2 : (s'=1) + 1/2 : (s'=2);

    [] s=1 & h=0 -> (s'=3);
    [] s=1 & h=1 -> 1/4 : (s'=3) + 3/4 : (s'=4);
    [] s=1 & h=2 -> 1/2 : (s'=3) + 1/2 : (s'=4);

    [] s=2 -> (s'=1);

    [] s>2 -> true;
endmodule

label "goal" = s=2 | s=3;
label "condition" = s=1;

rewards "steps"
    true : 1;
endrewards
