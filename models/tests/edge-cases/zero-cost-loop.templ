// The least cost to the goal is 2, with H0=2. In state 1, H0=2 loops at no cost, and the scheduler Storm gives for the least cost over all designs takes
// H0=1 there and in state 0, a design of cost 8.5 (with H0=0 the goal is reached with probability 1/9 only).
dtmc

hole int H0 in {0..2};

module m
    s : [0..3] init 0;
    [a0_0] s=0 & H0=0 -> 4/6 : (s'=2) + 2/6 : (s'=1);
    [a0_1] s=0 & H0=1 -> 3/5 : (s'=0) + 2/5 : (s'=1);
    [a0_2] s=0 & H0=2 -> 4/4 : (s'=3);
    [a1_0] s=1 & H0=0 -> 1/5 : (s'=3) + 2/5 : (s'=2) + 2/5 : (s'=1);
    [a1_1] s=1 & H0=1 -> 3/6 : (s'=1) + 3/6 : (s'=3);
    [a1_2] s=1 & H0=2 -> 3/3 : (s'=1);
    [] s=2 -> true;
    [] s=3 -> true;
endmodule

label "goal" = s=3;

rewards "cost"
    [a0_0] true : 3;
    [a0_1] true : 1;
    [a0_2] true : 2;
    [a1_0] true : 3;
    [a1_1] true : 3;
    [a1_2] true : 0;
endrewards
