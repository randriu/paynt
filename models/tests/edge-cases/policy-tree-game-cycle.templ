// A random family (seed 4302 of tests/mdp_family/test_random_families.py) on which Storm's policy iteration for the game of the policy tree cycles
// forever (with P>=0.708333 [F "goal"]): it improves the strategies of both players at once.
mdp

hole int H0 in {0..1};
hole int H1 in {0..2};

module m
    s : [0..4] init 0;
    [c0] s=0 -> 2/3 : (s'=3) + 1/3 : (s'=0);
    [a0] s=0 -> 3/6 : (s'=1) + 3/6 : (s'=4);
    [b0] s=0 & H1=0 -> 1/5 : (s'=1) + 4/5 : (s'=2);
    [a1] s=1 -> 2/4 : (s'=3) + 2/4 : (s'=0);
    [b1] s=1 -> 1/1 : (s'=2);
    [c2] s=2 -> 1/1 : (s'=2);
    [a2] s=2 & H1=0 -> 2/10 : (s'=3) + 4/10 : (s'=1) + 4/10 : (s'=0);
    [a2] s=2 & H1=1 -> 1/1 : (s'=1);
    [a2] s=2 & H1=2 -> 3/6 : (s'=2) + 1/6 : (s'=3) + 2/6 : (s'=0);
    [b2] s=2 & H0=0 -> 1/3 : (s'=1) + 2/3 : (s'=3);
    [] s=3 -> true;
    [] s=4 -> true;
endmodule

label "goal" = s=4;
