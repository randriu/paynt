// A random family (seed 2923 of tests/mdp_family/test_random_families.py). With P<=1.1 [F "goal"] every member is satisfied by any policy that keeps
// a choice in it. The policy tree solves H0=0, H0=1 and H0=2 separately; merging H0=0 into H0=2 and then H0=1 into both used to check H0=1's policy for
// H0=2 only, though it takes a1 in state 1, which H0=0 does not offer.
mdp

hole int H0 in {0..2};

module m
    s : [0..4] init 0;
    [b0] s=0 -> 4/6 : (s'=4) + 2/6 : (s'=2);
    [a0] s=0 & H0=0 -> 1/5 : (s'=1) + 1/5 : (s'=0) + 3/5 : (s'=3);
    [a0] s=0 & H0=1 -> 4/10 : (s'=1) + 2/10 : (s'=2) + 4/10 : (s'=3);
    [a0] s=0 & H0=2 -> 1/3 : (s'=4) + 2/3 : (s'=0);
    [c0] s=0 & H0=0 -> 4/4 : (s'=2);
    [c0] s=0 & H0=1 -> 3/3 : (s'=1);
    [c0] s=0 & H0=2 -> 2/4 : (s'=0) + 1/4 : (s'=4) + 1/4 : (s'=3);
    [c1] s=1 -> 4/12 : (s'=4) + 4/12 : (s'=1) + 4/12 : (s'=0);
    [b1] s=1 & H0=1 -> 3/7 : (s'=0) + 4/7 : (s'=4);
    [b1] s=1 & H0=2 -> 1/5 : (s'=0) + 4/5 : (s'=2);
    [a1] s=1 & H0=1 -> 2/5 : (s'=2) + 3/5 : (s'=4);
    [a1] s=1 & H0=2 -> 4/7 : (s'=0) + 2/7 : (s'=1) + 1/7 : (s'=3);
    [c2] s=2 -> 1/5 : (s'=1) + 4/5 : (s'=2);
    [b2] s=2 & H0=0 -> 3/8 : (s'=3) + 1/8 : (s'=1) + 4/8 : (s'=2);
    [b2] s=2 & H0=1 -> 2/7 : (s'=0) + 1/7 : (s'=3) + 4/7 : (s'=2);
    [a2] s=2 -> 2/3 : (s'=4) + 1/3 : (s'=1);
    [c3] s=3 -> 2/2 : (s'=2);
    [a3] s=3 & H0=0 -> 1/1 : (s'=2);
    [] s=4 -> true;
endmodule

label "goal" = s=4;
