// The same mistake of AR, seen through hybrid. H=1 reaches the goal surely and costs 8/3 on average; H=2 reaches it half of the time, so its expected
// cost is infinite; H=0 never reaches it. hybrid.props wants the goal reached with probability above 1/4 and a cost below 2.75: only H=1 does both.
//
// At the root, the cheapest scheduler is H=1 alone, which satisfies the whole specification, so the cost constraint is taken as satisfied by every design
// and the nodes below check the probability only. AR finds H=1 first and stops; hybrid keeps searching after that and accepts H=2.
dtmc

hole int H in {0,1,2};

module m
    s : [0..3] init 0;    // 3: goal, 2: stuck
    [a0] s=0 & H=0 -> 1/3 : (s'=0) + 2/3 : (s'=2);
    [a1] s=0 & H=1 -> (s'=1);
    [a2] s=0 & H=2 -> 3/7 : (s'=2) + 1/7 : (s'=0) + 3/7 : (s'=1);
    [b0] s=1 & H=0 -> 1/2 : (s'=3) + 1/2 : (s'=0);
    [b1] s=1 & H=1 -> 1/5 : (s'=1) + 1/5 : (s'=0) + 3/5 : (s'=3);
    [b2] s=1 & H=2 -> (s'=3);
    [] s>=2 -> true;
endmodule

label "goal" = s=3;

rewards "cost"
    [a0] true : 1;
    [a1] true : 2;
    [a2] true : 3;
    [b0] true : 1;
    [b1] true : 0;
    [b2] true : 3;
endrewards
